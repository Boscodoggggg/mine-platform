# 复制为 deploy/.env，并将文件权限设为 0600。生产环境镜像应替换为离线仓库地址@sha256:digest。
MINE_JAVA_IMAGE=eclipse-temurin:21.0.7_6-jre-jammy
MINE_NGINX_IMAGE=nginx:1.29.0-alpine
MINE_RABBITMQ_IMAGE=rabbitmq:4.1.8-management
MINE_POSTGRES_IMAGE=postgres:18.4-alpine
MINE_TIMESCALE_IMAGE=timescale/timescaledb:2.28.2-pg18-oss@sha256:8ed8d7336f00a3a90bb6fe709d506172012c7e673e0cf71465491d06e2db5fbd
MINE_REDIS_IMAGE=redis:8.2-alpine
MINE_PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
MINE_GRAFANA_IMAGE=grafana/grafana:13.0.2
MINE_LOKI_IMAGE=grafana/loki:3.7.2
MINE_ALLOY_IMAGE=grafana/alloy:v1.16.1
MINE_POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.19.1
MINE_REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.84.0
MINE_RUSTFS_IMAGE=rustfs/rustfs:1.0.0-beta.10@sha256:60f4f2f41ce95216f8cac676e69f9d90c0bfec458a3bc7fd7fb9b7c2452ac57a

MINE_HTTPS_PORT=443
MINE_MQTTS_PORT=8883
MINE_GATEWAY_TCP_PUBLISHED_ADDRESS=127.0.0.1
MINE_GATEWAY_TCP_PORT=9000
MINE_GATEWAY_TCP_MODE=LEGACY
MINE_GATEWAY_TCP_PROTOCOL_KEY=haul-truck-binary
MINE_GATEWAY_TCP_WORKER_THREADS=2
MINE_GATEWAY_TCP_BUSINESS_THREADS=4
MINE_GATEWAY_TCP_BACKLOG=1024
MINE_GATEWAY_TCP_MAX_CONNECTIONS=10000
MINE_GATEWAY_TCP_MAX_CONNECTIONS_PER_IP=100
MINE_GATEWAY_TCP_READ_IDLE_SECONDS=120
MINE_GATEWAY_TCP_SHUTDOWN_TIMEOUT=30s
# 单机默认仅用于受控内网演示；生产必须改为 true 并替换 tls.crt/tls.key。
MINE_GATEWAY_TCP_TLS_ENABLED=false
MINE_GRAFANA_PORT=3000
MINE_GRAFANA_BIND_ADDRESS=127.0.0.1
MINE_PROMETHEUS_PORT=9090
MINE_LOKI_PORT=3100
MINE_REDIS_MAXMEMORY=384mb
MINE_TLS_SERVER_NAME=mine.local
MINE_TIMEZONE=Asia/Shanghai
MINE_DEPLOY_PROFILE=
MINE_SERVER_JAR_PATH=./backend/mine-server.jar
MINE_GATEWAY_JAR_PATH=./backend/mine-gateway.jar
MINE_TELEMETRY_JAR_PATH=./backend/mine-telemetry.jar
MINE_WEB_DIST_PATH=./frontend/dist
MINE_CERTS_DIR=./certs
MINE_RUSTFS_ACCESS_KEY=change-me-rustfs-access-key
MINE_RUSTFS_SECRET_KEY=change-me-rustfs-secret-key
MINE_OBJECT_STORAGE_S3_REGION=us-east-1
MINE_OBJECT_STORAGE_S3_BUCKET=mine-scene-assets

POSTGRES_DB=mine
POSTGRES_USER=mine
POSTGRES_PASSWORD=change-me-postgres
TIMESCALE_DB=mine_telemetry
TIMESCALE_USER=mine_ts
TIMESCALE_PASSWORD=change-me-timescale
TIMESCALE_READER_USER=mine_ts_reader
TIMESCALE_READER_PASSWORD=change-me-timescale-reader
TIMESCALE_REPLAY_USER=mine_ts_replay
TIMESCALE_REPLAY_PASSWORD=change-me-timescale-replay
REDIS_PASSWORD=change-me-redis

RABBITMQ_ADMIN_USERNAME=mine-admin
RABBITMQ_ADMIN_PASSWORD=change-me-rabbitmq-admin
RABBITMQ_GATEWAY_DEVICE_PASSWORD=change-me-rabbitmq-gateway-device
RABBITMQ_GATEWAY_PLATFORM_PASSWORD=change-me-rabbitmq-gateway-platform
RABBITMQ_TELEMETRY_PASSWORD=change-me-rabbitmq-telemetry
RABBITMQ_SERVER_REALTIME_PASSWORD=change-me-rabbitmq-server-realtime
RABBITMQ_SERVER_COMMAND_PASSWORD=change-me-rabbitmq-server-command
RABBITMQ_SERVER_ALARM_PASSWORD=change-me-rabbitmq-server-alarm
RABBITMQ_SERVER_OPERATION_PASSWORD=change-me-rabbitmq-server-operation
RABBITMQ_SERVER_OPERATION_OUTBOX_PASSWORD=change-me-rabbitmq-server-operation-outbox
MINE_CONFIGURATION_DISTRIBUTION_TOKEN=change-me-configuration-distribution-token

MINE_BOOTSTRAP_ADMIN_ID=0198aef6-2e80-7000-8000-000000000001
MINE_BOOTSTRAP_ADMIN_USERNAME=mine-admin
MINE_BOOTSTRAP_ADMIN_DISPLAY_NAME=矿区超级管理员
MINE_SUPER_ADMIN_PASSWORD=change-me-super-admin
MINE_PERSON_DATA_KEY=change-me-person-data-key
MINE_NOTIFICATION_DATA_KEY=change-me-notification-data-key
MINE_PASSWORD_BCRYPT_STRENGTH=12
MINE_AUTH_ACTIVE_TIMEOUT_SECONDS=1800
MINE_GRAFANA_ADMIN_USER=mine-admin
MINE_GRAFANA_ADMIN_PASSWORD=change-me-grafana

# 数值聚合与显式重算在应用默认关闭；单机 Compose 显式启用并使用以下受控上限。
MINE_TELEMETRY_AGGREGATION_BATCH_SIZE=1000
MINE_TELEMETRY_AGGREGATION_MAX_CYCLES=10
MINE_TELEMETRY_AGGREGATION_INITIAL_DELAY=30s
MINE_TELEMETRY_AGGREGATION_INTERVAL=1m
MINE_TELEMETRY_AGGREGATION_STALE_TIMEOUT=2h
MINE_TELEMETRY_AGGREGATION_RECOMPUTE_LEASE=10m
