{
  "name": "@bosco/mine-web",
  "version": "0.1.0",
  "private": true,
  "description": "智慧矿山数据采集与设备管理平台前端",
  "keywords": [
    "TypeScript",
    "Vite",
    "Vue3",
    "mqtt",
    "naive-ui",
    "smart-mine"
  ],
  "license": "MIT",
  "author": "Bosco Mine contributors",
  "type": "module",
  "scripts": {
    "build": "vite build --mode prod",
    "build:test": "vite build --mode test",
    "check:ui-governance": "vitest run src/test/ui-governance.test.ts",
    "cleanup": "sa cleanup",
    "commit": "sa git-commit",
    "commit:zh": "sa git-commit -l=zh-cn",
    "dev": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "fmt": "oxfmt",
    "gen-route": "sa gen-route",
    "gen:api": "openapi-typescript ../docs/openapi/mine-api.yaml -o src/generated/mine-api.ts",
    "lint": "oxlint --fix && eslint --fix .",
    "lint:check": "pnpm check:ui-governance && oxlint && eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/vitest-junit.xml",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "update-pkg": "sa update-pkg"
  },
  "dependencies": {
    "@better-scroll/core": "2.5.1",
    "@iconify/vue": "5.0.1",
    "@sa/axios": "workspace:*",
    "@sa/color": "workspace:*",
    "@sa/hooks": "workspace:*",
    "@sa/materials": "workspace:*",
    "@sa/utils": "workspace:*",
    "@vueuse/core": "14.3.0",
    "clipboard": "2.0.11",
    "dayjs": "1.11.20",
    "defu": "6.1.7",
    "echarts": "6.0.0",
    "json5": "2.2.3",
    "naive-ui": "2.44.1",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "tailwind-merge": "3.6.0",
    "vue": "3.5.34",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.4.2",
    "vue-router": "5.0.7"
  },
  "devDependencies": {
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.472",
    "@playwright/test": "1.59.0",
    "@sa/scripts": "workspace:*",
    "@sa/uno-preset": "workspace:*",
    "@soybeanjs/eslint-config-vue": "^0.0.2",
    "@types/node": "25.7.0",
    "@types/nprogress": "0.2.3",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "@vue/compiler-sfc": "3.5.34",
    "@vue/test-utils": "2.4.11",
    "consola": "3.4.2",
    "eslint": "10.3.0",
    "happy-dom": "20.10.6",
    "kolorist": "1.8.0",
    "openapi-typescript": "7.10.1",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "sass": "1.99.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "unocss": "^66.6.8",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.0.0",
    "vite": "8.0.12",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "8.1.2",
    "vite-plugin-vue-transition-root-validator": "^0.1.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.2.8"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.5.0"
  }
}
