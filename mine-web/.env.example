# 复制为 .env 后按现场环境调整；.env 不提交仓库。
VITE_BASE_URL=/
VITE_APP_TITLE=智慧矿山数据平台
VITE_APP_DESC=矿区本地部署的设备接入、实时监测与运行管理平台
VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=icon-local
VITE_AUTH_ROUTE_MODE=dynamic
VITE_ROUTE_HOME=home
VITE_MENU_ICON=mdi:menu
VITE_HTTP_PROXY=Y
VITE_ROUTER_HISTORY_MODE=history
VITE_SERVICE_SUCCESS_CODE=200
VITE_SERVICE_LOGOUT_CODES=AUTH-401-002
VITE_SERVICE_MODAL_LOGOUT_CODES=
VITE_SERVICE_EXPIRED_TOKEN_CODES=
VITE_STATIC_SUPER_ROLE=R_SUPER
VITE_SOURCE_MAP=N
VITE_STORAGE_PREFIX=MINE_
VITE_SERVICE_BASE_URL=/api/v1
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
VITE_OTHER_SERVICE_BASE_URL={}
VITE_AUTOMATICALLY_DETECT_UPDATE=Y
VITE_PROXY_LOG=Y
VITE_DEVTOOLS_LAUNCH_EDITOR=code
