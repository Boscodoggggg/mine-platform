# 复制为 standalone.env。生产环境镜像应替换为离线仓库地址@sha256:digest。
MINE_JAVA_IMAGE=eclipse-temurin:21.0.7_6-jre-jammy
MINE_NGINX_IMAGE=nginx:1.29.0-alpine
MINE_RABBITMQ_IMAGE=rabbitmq:4.1.8-management
MINE_POSTGRES_IMAGE=postgres:18.4-alpine
MINE_TIMESCALE_IMAGE=timescale/timescaledb:2.22.1-pg17
MINE_REDIS_IMAGE=redis:8.2-alpine

MINE_HTTPS_PORT=443
MINE_MQTTS_PORT=8883
MINE_TLS_SERVER_NAME=mine.local
MINE_TIMEZONE=Asia/Shanghai
MINE_SECRETS_DIR=../secrets
MINE_WEB_DIST_PATH=../../mine-web/dist

POSTGRES_DB=mine
POSTGRES_USER=mine
TIMESCALE_DB=mine_telemetry
TIMESCALE_USER=mine_ts

MINE_BOOTSTRAP_ADMIN_ID=0198aef6-2e80-7000-8000-000000000001
MINE_BOOTSTRAP_ADMIN_USERNAME=mine-admin
MINE_BOOTSTRAP_ADMIN_DISPLAY_NAME=矿区超级管理员
MINE_PASSWORD_BCRYPT_STRENGTH=12
MINE_AUTH_ACTIVE_TIMEOUT_SECONDS=1800
